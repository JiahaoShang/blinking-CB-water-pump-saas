+
+ROOT = Path(__file__).resolve().parents[2]
+
+REQUIRED_ENV_PREFIXES = ("DEEPSEEK", "DIFY", "TWILIO", "META", "LANGBOT", "WHATSAPP", "AI_MODE")
+ADMIN_EMAIL = "t4-drill-admin@example.invalid"
+ADMIN_PASSWORD = "t4-drill-password-123"
