+        self.assertTrue(manual.exists(), "非本工具命名的目录不得清理")
+        self.assertTrue(note.exists(), "非目录文件不得清理")
+        self.assertEqual(len(find_bundle_dirs(self.backup_root)), 2)  # recent + 本次新备份
