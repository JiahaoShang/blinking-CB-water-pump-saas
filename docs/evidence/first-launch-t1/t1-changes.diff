+def _append_private_log(path, line: str) -> None:
+    """追加写诊断/审计日志：新文件 0600、旧文件收紧到 0600（不随进程 umask 变成其他本地用户可读）。"""
+    fd = os.open(path, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o600)
