    labels:
      b2b.langbot: "1"
    networks:
      b2b-langbot-net: null
    ports:
      - mode: ingress
        host_ip: 127.0.0.1
        target: 5300
        published: "5300"
        protocol: tcp
    restart: unless-stopped
    volumes:
      - type: bind
        source: /var/lib/b2b/data/connection-runtime/langbot/core
        target: /app/data
        bind: {}
  b2b-langbot-plugin:
    command:
      - uv
      - run
      - --no-sync
      - -m
      - langbot_plugin.cli.__init__
      - rt
    container_name: b2b-langbot-plugin
    environment:
      LANGBOT_PLUGIN_RUNTIME_CONTROL_TOKEN: <placeholder-redacted>_CONTROL_TOKEN_0123456789abcdef
    image: rockchin/langbot@sha256:ed8c7f19d7e44cda8b59a803be78c4cbecd294e7de1e53d114517f2c034e6e40
    labels:
      b2b.langbot: "1"
    networks:
      b2b-langbot-net: null
    restart: unless-stopped
    volumes:
      - type: bind
        source: /var/lib/b2b/data/connection-runtime/langbot/plugin
        target: /app/data/plugins
        bind: {}
networks:
