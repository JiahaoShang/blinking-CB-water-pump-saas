e></svg>产品展示页<span class=\'side-count\' data-nav-count=\'creative\' data-count=\'0\' hidden><span class=\'n\'></span></span></a><div class=\'side-heading\'>经营分析</div><a class=\'side-link\' href=\'/admin/analytics\'><svg class=\'ic\' aria-hidden=\'true\'><use href=\'#i-chart\'></use></svg>分析报表<span class=\'side-count\' data-nav-count=\'analytics\' data-count=\'0\' hidden><span class=\'n\'></span></span></a><div class=\'side-heading\'>团队与接入</div><a class=\'side-link\' href=\'/admin/users\'><svg class=\'ic\' aria-hidden=\'true\'><use href=\'#i-users\'></use></svg>成员管理<span class=\'side-count\' data-nav-count=\'users\' data-count=\'0\' hidden><span class=\'n\'></span></span></a><a class=\'side-link\' href=\'/admin/sites\'><svg class=\'ic\' aria-hidden=\'true\'><use href=\'#i-globe\'></use></svg>网站 API 接入<span class=\'side-count\' data-nav-count=\'sites\' data-count=\'0\' hidden><span class=\'n\'></span></span></a><div class=\'side-heading\'>设置与治理</div><a class=\'side-link\' href=\'/admin/settings\'><svg class=\'ic\' aria-hidden=\'true\'><use href=\'#i-sliders\'></use></svg>企业设置<span class=\'side-count\' data-nav-count=\'settings\' data-count=\'0\' hidden><span class=\'n\'></span></span></a><a class=\'side-link\' href=\'/admin/channels\'><svg class=\'ic\' aria-hidden=\'true\'><use href=\'#i-plug\'></use></svg>渠道接入<span class=\'side-count\' data-nav-count=\'channels\' data-count=\'0\' hidden><span class=\'n\'></span></span></a><a class=\'side-link\' href=\'/admin/audit\'><svg class=\'ic\' aria-hidden=\'true\'><use href=\'#i-history\'></use></svg>操作记录<span class=\'side-count\' data-nav-count=\'audit\' data-count=\'0\' hidden><span class=\'n\'></span></span></a></nav>\n<div class=\'side-foot\'><details class=\'account-menu\'><summary aria-label=\'打开账号菜单\'><span class=\'tenant-avatar\' aria-hidden=\'true\'>D</span><span class=\'account-label\'>demo-admin@example.invalid<small>管理员</small></span><svg class=\'ic\' aria-hidden=\'true\'><use href=\'#i-menu\'></use></svg></summary><div class=\'account-popover\'><a href=\'/admin/preferences\'><svg class=\'ic\' aria-hidden=\'true\'><use href=\'#i-sliders\'></use></svg>设置</a><a href=\'/logout\'><svg class=\'ic\' aria-hidden=\'true\'><use href=\'#i-users\'></use></svg>退出登录</a></div></details><a href=\'/inquiry\' target=\'_blank\'>打开买方演示页 ↗</a></div>\n</aside>\n<div class=\'shell\'>\n<header class=\'topbar\'><button class=\'menu-btn\' id=\'console-menu\' aria-label=\'打开导航\'><svg class=\'ic\' aria-hidden=\'true\'><use href=\'#i-menu\'></use></svg></button><span class=\'crumb\'>产品经营 / <b>发布设置</b></span><span class=\'grow\'></span><button class=\'theme-toggle\' id=\'themeToggle\' type=\'button\' title=\'切换浅色 / 深色（快捷键 D）\' aria-label=\'切换主题\'><svg class=\'tt-sun\' viewBox=\'0 0 24 24\' aria-hidden=\'true\'><circle cx=\'12\' cy=\'12\' r=\'4\'/><path d=\'M12 2v2\'/><path d=\'M12 20v2\'/><path d=\'m4.93 4.93 1.41 1.41\'/><path d=\'m17.66 17.66 1.41 1.41\'/><path d=\'M2 12h2\'/><path d=\'M20 12h2\'/><path d=\'m6.34 17.66-1.41 1.41\'/><path d=\'m19.07 4.93-1.41 1.41\'/></svg><svg class=\'tt-moon\' viewBox=\'0 0 24 24\' aria-hidden=\'true\'><path d=\'M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9\'/></svg></button><a href=\'/admin/knowledge/batch/098cbb21d43e94836ec0b73d?lang=en\'>English</a></header>\n<main><style>\n.console .ux-guide{margin:0 0 20px;padding:14px 18px;border-left:3px solid var(--accent);background:var(--surface-2);border-radius:0 var(--r-md) var(--r-md) 0}\n.console .ux-guide strong{font-size:14px;color:var(--text-1)}.console .ux-guide p{margin:5px 0 0;font-size:13px;color:var(--text-2)}\n.console .ux-guide .ux-path{font-size:12px;margin-top:9px;color:var(--text-3)}\n.console .ux-section-nav{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 20px}\n.console .ux-section-nav a{font-size:12px;padding:6px 10px;border:1px solid var(--border);border-radius:var(--r-md);color:var(--text-2)}\n.console .ux-fold{border:1px solid var(--border);border-radius:var(--r-lg);background:var(--surface);margin:0 0 16px;min-width:0}\n.console .ux-fold>summary{cursor:pointer;padding:16px 18px;color:var(--text-1);font-weight:500;font-size:14px}\n.console .ux-fold>section.card{margin:0!important;border:0;border-top:1px solid var(--border);box-shadow:none}\n.console .ux-fold>section>.panel-title h2,.console .ux-fold>section>h2{display:none}\n.console .ux-fold summary:focus-visible,.console .ux-section-nav a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}\n.console .ux-filter{margin:12px 0}.console .ux-filter>summary{cursor:pointer;color:var(--text-2);font-size:13px}\n.console .ux-tools>summary{cursor:pointer;font-size:12px;color:var(--text-2)}.console .ux-tools-actions{display:flex;gap:6px;flex-wrap:wrap;padding-top:8px}.console .ux-guide+nav{margin-top:-6px}.console .ux-section-nav~section{scroll-margin-top:80px}\n@media(max-width:720px){.console .ux-guide{padding:12px}.console .ux-section-nav{gap:6px}.console .ux-section-nav a{padding:6px 8px}}\n</style><aside id="ux-guide" class="ux-guide" aria-label="操作引导"><strong>三步把资料变成可核对的知识</strong><p>添加资料 → 检查整理结果（核对正文、确认主题）→ 发布设置；完成识别只创建草稿，不会自动发布。</p><p class="ux-path">添加资料 → 核对正文 → 确认主题与发布</p></aside><link rel=\'stylesheet\' href=\'/admin/knowledge/assets/knowledge-phase2.css?v=20261012-task3\'><script src=\'/admin/knowledge/assets/knowledge-phase2.js?v=20261012-task3\' defer></script><svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>\n<symbol id="kb2-chev" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></symbol>\n<symbol id="kb2-x" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></symbol>\n<symbol id="kb2-back" viewBox="0 0 24 24"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></symbol>\n<symbol id="kb2-image" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.09-3.09a2 2 0 0 0-2.82 0L6 21"/></symbol>\n<symbol id="kb2-video" viewBox="0 0 24 24"><path d="m16 13 5.24 3.5a.5.5 0 0 0 .76-.43V7.93a.5.5 0 0 0-.76-.43L16 11"/><rect x="2" y="6" width="14" height="12" rx="2"/></symbol>\n<symbol id="kb2-pen" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></symbol>\n<symbol id="kb2-upload" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><path d="M12 3v12"/></symbol>\n<symbol id="kb2-link" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></symbol>\n<symbol id="kb2-folder" viewBox="0 0 24 24"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></symbol>\n<symbol id="kb2-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m16 9-5.5 5.5L8 12"/></symbol>\n<symbol id="kb2-alert" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></symbol>\n</defs></svg><div class=\'kb2\'><div class=\'steps\' aria-label=\'添加资料步骤\'><a class=\'step\' href=\'/admin/knowledge/add\'><span class=\'n\'>1</span>添加资料</a><span class=\'sep\'></span><a class=\'step\' href=\'/admin/knowledge/batch/098cbb21d43e94836ec0b73d\'><span class=\'n\'>2</span>检查整理结果</a><span class=\'sep\'></span><a class=\'step on\' href=\'/admin/knowledge/batch/098cbb21d43e94836ec0b73d?step=publish\'><span class=\'n\'>3</span>发布设置</a></div><div class=\'toolbar\'><div><h1>检查整理结果</h1><p class=\'lead\'>本批 1 件：已识别 0 · 仅登记 0 · 未能识别 0 · 处理中 0。完成识别只创建草稿，绝不自动发布。</p></div><div class=\'actions\'><a class=\'button secondary\' href=\'/admin/knowledge/batch/098cbb21d43e94836ec0b73d\'><svg class=\'ic\' aria-hidden=\'true\'><use href=\'#i-history\'></use></svg>刷新状态</a></div></div><div class=\'card\'><h2>发布校验</h2><div class=\'gates\'></div></div><div class=\'card\'><h2>发布设置</h2><form method=\'post\' action=\'/admin/knowledge/batch/098cbb21d43e94836ec0b73d/settings\'><fieldset class=\'settings-group\'><legend>用途</legend><label class=\'check-inline\'><input type=\'radio\' name=\'usage\' value=\'internal\' checked> <span>仅内部使用（默认）</span></label><label class=\'check-inline\'><input type=\'radio\' name=\'usage\' value=\'external\'> <span>对外使用（客户可见的 AI 回答）</span></label></fieldset><fieldset class=\'settings-group\'><legend>AI 客服使用</legend><label class=\'check-inline\'><input type=\'checkbox\' name=\'ai_authorized\' value=\'1\' data-kb2-ai-toggle> <span>授权 AI 客服使用（默认关闭）</span></label><p class=\'hint-line\' id=\'kb2-ai-confirm-hint\'>对外且授权 AI 时，发布前需要一次确认；仅登记原件即使授权 AI 也不可用。</p></fieldset><fieldset class=\'settings-group\'><legend>到期（可选）</legend><div class=\'inline-row\'><input type=\'date\' name=\'expiry_date\' value=\'\' aria-label=\'到期日期\'><input type=\'time\' name=\'expiry_time\' aria-label=\'到期时间\'></div><p class=\'hint-line\'>留空 = 长期有效；到期时间按北京时间保存。</p></fieldset><div class=\'review-footer\'><span class=\'hint-line\'>保存设置允许不完整；发布后仍可修改设置（生成新草稿）。</span><span class=\'actions\'><button class=\'button secondary\' name=\'action\' value=\'save\'>保存设置</button><button class=\'button\' name=\'action\' value=\'publish\' data-kb2-confirm=\'发布前会逐件校验正文核对情况；对外且授权 AI 需要确认。继续发布？\' data-kb2-confirm-title=\'发布批次\' data-kb2-confirm-field=\'confirm_ai\' data-kb2-confirm-value=\'1\'>发布</button></span></div><input type=\'hidden\' name=\'confirm_ai\' value=\'0\'></form></div></div><script>(function(){\nvar config={"key": "knowledge_add", "fold": []};\nfunction init(){\nvar main=document.querySelector(\'.console main\');if(!main)return;\nvar guide=document.getElementById(\'ux-guide\');var toolbar=main.querySelector(\'.toolbar\');\nif(toolbar)toolbar.after(guide);\nvar headings=Array.from(main.querySelectorAll(\'section.card h2\')).filter(function(h){return h.closest(\'section.card\').querySelector(\'h2\')===h;});\nvar nav=document.createElement(\'nav\');nav.className=\'ux-section-nav\';nav.setAttribute(\'aria-label\',\'本页操作入口\');\nheadings.forEach(function(h,i){\nvar section=h.closest(\'section.card\');var label=h.textContent.trim();\nif(section.closest(\'.chat-shell\'))return;\nif(!section.id)section.id=\'ux-section-\'+i;\nvar link=document.createElement(\'a\');link.href=\'#\'+section.id;link.textContent=label;nav.appendChild(link);\nif(config.fold.includes(label)||config.fold.includes(\'*\')){\nvar details=document.createElement(\'details\');details.className=\'ux-fold\';\nvar summary=document.createElement(\'summary\');summary.textContent=label;\n// 保存后的提示及服务端错误保持可见；不让用户寻找刚操作的区域。\nvar notice=(new URLSearchParams(location.search).get(\'notice\')||\'\').split(\'_\')[0];\nvar feedback={products:{source:\'登记来源资料\',category:\'品类（候选与核准）\'},settings:{stages:\'线索阶段\',fields:\'RFQ 询价表单字段\',notify:\'通知接收人\',\'rfq-category\':\'按品类询价字段（可选）\'}};\ndetails.open=!!(feedback[config.key]&&feedback[config.key][notice]===label)||(config.key===\'knowledge\'&&i===0);\nsection.before(details);details.append(summary,section);\n}\n});\nif(headings.length>1&&headings.length<=5&&![\'settings\',\'knowledge\'].includes(config.key))guide.after(nav);\n// 筛选条件仍使用原 GET 表单，已筛选时默认展开，避免隐藏当前筛选口径。\nif(config.key===\'sales\'){\nvar filter=main.querySelector(\'form.filter-bar\');if(filter){var wrap=document.createElement(\'details\');wrap.className=\'ux-filter\';var summary=document.createElement(\'summary\');summary.textContent=\'按阶段、负责人或关键词筛选\';\nwrap.open=Array.from(filter.querySelectorAll(\'input,select\')).some(function(el){return !!el.value;});filter.before(wrap);wrap.append(summary,filter);}}\n// 新建入口出现在页首；原表单仍在原位置，按钮只负责展开与定位。\nvar createLabels={products:\'新建产品型号\',users:\'创建成员账号\',sites:\'登记新的官网来源\'};\nif(toolbar&&createLabels[config.key]){var disclosure=Array.from(main.querySelectorAll(\'details\')).find(function(d){return d.querySelector(\'summary\')&&d.querySelector(\'summary\').textContent.trim()===createLabels[config.key];});\nif(disclosure){var action=document.createElement(\'button\');action.type=\'button\';action.textContent=createLabels[config.key];toolbar.appendChild(action);\nif(main.querySelector(\'.simple-item\'))disclosure.open=false;\naction.addEventListener(\'click\',function(){disclosure.open=true;disclosure.scrollIntoView({block:\'center\'});var field=disclosure.querySelector(\'input\');if(field)field.focus();});}}\n// 核对页优先看仍待处理的字段，完整表格始终可以切回。\nif(config.key===\'products\'){\nvar table=main.querySelector(\'#fields>table\');if(table){var rows=Array.from(table.querySelectorAll(\'tbody>tr\'));var pending=rows.filter(function(row){return !!row.querySelector(\'.badge.pending_review\');});\nif(pending.length&&pending.length<rows.length){var toggle=document.createElement(\'button\');toggle.type=\'button\';toggle.className=\'secondary\';var onlyPending=!new URLSearchParams(location.search).has(\'notice\');\nfunction renderFields(){rows.forEach(function(row){row.hidden=onlyPending&&!pending.includes(row);});toggle.textContent=onlyPending?\'查看全部 \'+rows.length+\' 个字段\':\'只看待核对的 \'+pending.length+\' 个字段\';}\ntable.before(toggle);renderFields();toggle.addEventListener(\'click\',function(){onlyPending=!onlyPending;renderFields();});}}}\nif(config.key===\'sales\'){\nvar stop=main.querySelector(\'form[action$="/contact-stop"]\');if(stop){var stopDetails=document.createElement(\'details\');stopDetails.className=\'ux-filter\';var summary=document.createElement(\'summary\');summary.textContent=\'记录客户停止主动联系的要求\';stop.before(stopDetails);stopDetails.append(summary,stop);}}\nif(config.key===\'audit\')main.querySelectorAll(\'.simple-list details.detail-toggle>summary\').forEach(function(summary){summary.textContent=\'查看变更详情\';});\nif(config.key===\'creative\'){\nmain.querySelectorAll(\'.pcard .tools\').forEach(function(tools){var actions=Array.from(tools.children).filter(function(el){return !el.querySelector(\'.ptoggle\')&&!el.classList.contains(\'lock\');});\nif(!actions.length)return;var more=document.createElement(\'details\');more.className=\'ux-tools\';var summary=document.createElement(\'summary\');summary.textContent=\'编辑与排序\';var panel=document.createElement(\'div\');panel.className=\'ux-tools-actions\';tools.appendChild(more);more.append(summary,panel);actions.forEach(function(el){panel.appendChild(el);});});\nvar path=guide.querySelector(\'.ux-path\');if(path&&main.querySelector(\'.flowbar\'))path.hidden=true;\nvar coach=main.querySelector(\'.coach\');if(coach){var help=document.createElement(\'details\');help.className=\'ux-filter\';var summary=document.createElement(\'summary\');summary.textContent=\'查看初次制作说明\';coach.before(help);help.append(summary,coach);}\nvar pool=main.querySelector(\'.pchips\');if(pool){var library=document.createElement(\'details\');library.className=\'ux-filter\';var summary=document.createElement(\'summary\');summary.textContent=\'添加更多参数或内容板块\';\nvar caption=pool.previousElementSibling;pool.before(library);library.appendChild(summary);if(caption&&caption.classList.contains(\'muted\'))library.appendChild(caption);library.appendChild(pool);}}\nif(config.key===\'inbox_web\'){var chips=main.querySelector(\'.chat-chips\');if(chips){var context=document.createElement(\'details\');context.className=\'ux-filter\';var summary=document.createElement(\'summary\');summary.textContent=\'查看客户资料与关联业务\';chips.before(context);context.append(summary,chips);}}\nfunction reveal(target){if(!target)return;for(var parent=target.parentElement;parent;parent=parent.parentElement){if(parent.tagName===\'DETAILS\')parent.open=true;}if(target.tagName===\'DETAILS\')target.open=true;}\nfunction hashTarget(){var id;try{id=decodeURIComponent(location.hash.slice(1));}catch(e){return null;}return id?document.getElementById(id):null;}\nreveal(hashTarget());window.addEventListener(\'hashchange\',function(){reveal(hashTarget());});\nnav.addEventListener(\'click\',function(event){var link=event.target.closest(\'a\');if(link){reveal(document.getElementById(link.hash.slice(1)));}});\n// 浏览器校验隐藏的必填项时，展开对应区域，使原表单校验仍可操作。\nmain.addEventListener(\'invalid\',function(event){reveal(event.target);},true);\n}\nif(document.readyState===\'loading\')document.addEventListener(\'DOMContentLoaded\',init);else init();\n})();</script></main>\n</div>\n</div>\n<script>document.getElementById(\'console-menu\').addEventListener(\'click\',function(){document.getElementById(\'console-side\').classList.toggle(\'open\');});</script>\n<script>document.addEventListener(\'click\',function(event){var menu=document.querySelector(\'.account-menu\');if(menu && menu.open && !menu.contains(event.target)){menu.open=false;}});</script>\n<script>\n// 侧栏待办数字：每 5 秒轮询一次 /admin/nav-counts，只在数字真的变化时更新\n// （只动导航上的数字，不触碰页面正文）；变化时做机械表日历跳转式翻牌动画；\n// 系统启用"减少动态效果"时直接切换，不播动画。\n(function () {\n  var POLL_INTERVAL_MS = 5000;\n  var FLIP_MS = 120;\n  // 告急数字（加粗 + 放大 + 红）：与 app.py 的 HOT_COUNT_KEYS 保持一致\n  var HOT_KEYS = { tasks: true, sales: true };\n  var prefersReduce = false;\n  try { prefersReduce = window.matchMedia(\'(prefers-reduced-motion: reduce)\').matches; } catch (error) {}\n  function flipIn(num, text) {\n    num.textContent = text;\n    if (prefersReduce) { return; }\n    num.classList.add(\'flip-in\');\n    void num.offsetWidth;\n    num.classList.remove(\'flip-in\');\n  }\n  function flipSwap(num, text) {\n    if (prefersReduce) { num.textContent = text; return; }\n    num.classList.add(\'flip-out\');\n    setTimeout(function () {\n      num.textContent = text;\n      num.classList.remove(\'flip-out\');\n      num.classList.add(\'flip-in\');\n      void num.offsetWidth;\n      num.classList.remove(\'flip-in\');\n    }, FLIP_MS);\n  }\n  function applyCount(badge, value) {\n    var num = badge.querySelector(\'.n\');\n    var prev = parseInt(badge.getAttribute(\'data-count\') || \'0\', 10) || 0;\n    var hotNow = value > 0 && HOT_KEYS[badge.getAttribute(\'data-nav-count\')] === true;\n    if (value === prev && (value > 0) === (!badge.hidden) && hotNow === badge.classList.contains(\'hot\')) { return; }\n    badge.setAttribute(\'data-count\', String(value));\n    badge.classList.toggle(\'hot\', hotNow);\n    if (value <= 0) {\n      if (badge.hidden) { return; }\n      if (prefersReduce) { num.textContent = \'\'; badge.hidden = true; return; }\n      num.classList.add(\'flip-out\');\n      setTimeout(function () { num.textContent = \'\'; num.classList.remove(\'flip-out\'); badge.hidden = true; }, FLIP_MS);\n      return;\n    }\n    var text = value > 99 ? \'99+\' : String(value);\n    var appearing = badge.hidden;\n    badge.hidden = false;\n    if (appearing) { flipIn(num, text); } else { flipSwap(num, text); }\n  }\n  function pollNavCounts() {\n    fetch(\'/admin/nav-counts\', { headers: { \'Accept\': \'application/json\' }, cache: \'no-store\' })\n      .then(function (response) { return response.ok ? response.json() : null; })\n      .then(function (data) {\n        if (!data || !data.counts) { return; }\n        var badges = document.querySelectorAll(\'.side-count[data-nav-count]\');\n        for (var index = 0; index < badges.length; index += 1) {\n          var badge = badges[index];\n          var value = Number(data.counts[badge.getAttribute(\'data-nav-count\')] || 0);\n          if (!isFinite(value)) { value = 0; }\n          applyCount(badge, value);\n        }\n      })\n      .catch(function () { /* 静默：下一轮重试 */ });\n  }\n  setInterval(pollNavCounts, POLL_INTERVAL_MS);\n  document.addEventListener(\'visibilitychange\', function () { if (!document.hidden) { pollNavCounts(); } });\n})();\n</script>\n<script>\n// 企业知识折叠导航（任务3 / 清单3 / 清单13）：主按钮进入全部列表并展开；独立箭头只展开/收起；\n// 直接进入子视图（服务端标记 data-sub-active）无论会话里存过什么，都展开——服务端活动子视图优先；\n// 其余情况按 sessionStorage 记忆（显式展开优先于默认收起）；动画由 CSS 提供，reduced-motion 下禁用。\n(function(){\n  var toggle=document.querySelector(\'.side-toggle[data-nav-toggle]\');\n  var subs=document.getElementById(\'nav-knowledge-subs\');\n  if(!toggle||!subs){return;}\n  var key=\'kb-nav-expanded\';\n  var stored=null;\n  try{stored=sessionStorage.getItem(key);}catch(error){}\n  function apply(open){\n    subs.classList.toggle(\'open\',open);\n    if(open){subs.removeAttribute(\'inert\');subs.removeAttribute(\'aria-hidden\');}\n    else{subs.setAttribute(\'inert\',\'\');subs.setAttribute(\'aria-hidden\',\'true\');}\n    toggle.setAttribute(\'aria-expanded\',open?\'true\':\'false\');\n    toggle.setAttribute(\'aria-label\',open?\'收起知识分类\':\'展开知识分类\');\n  }\n  var serverOpen=subs.getAttribute(\'data-sub-active\')===\'1\';\n  // 清单13：服务端活动子视图优先于「会话里存过的收起」——直接进入子视图永远展开；\n  // 只有在没有活动子视图时，会话记忆才会覆盖默认收起。\n  apply(serverOpen||stored===\'1\');\n  function remember(){try{sessionStorage.setItem(key,\'1\');}catch(error){}}\n  toggle.addEventListener(\'click\',function(){\n    var open=!subs.classList.contains(\'open\');\n    try{sessionStorage.setItem(key,open?\'1\':\'0\');}catch(error){}\n    apply(open);\n  });\n  // 主按钮与子项：进入知识区展开并保持；页面跳转仍走链接默认行为，不绕过未保存保护。\n  var group=document.querySelector(\'.nav-main-row a[data-kb-nav-main]\');\n  if(group){group.addEventListener(\'click\',function(){remember();apply(true);});}\n  var subLinks=subs.querySelectorAll(\'a.side-link.sub\');\n  for(var i=0;i<subLinks.length;i+=1){\n    subLinks[i].addEventListener(\'click\',function(){remember();});\n  }\n})();\n</script>\n<script>\n// 侧栏模块磁吸放大（macOS Dock 手法竖向移植）：\n// 指针靠近哪一项，哪一项平滑放大——行高增长 + 图标弹性放大，下方条目被自然顶开；\n// 目标尺寸按指针到条目中心的距离线性衰减（与参考组件一致的磁吸手感），用弹簧物理平滑\n// （参数沿用参考组件默认值）；指针离开侧栏整列弹回。\n// 纯原生实现（本项目无 React/framer-motion）；触屏（无 hover 指针）与系统"减少动态效果"时不启用。\n(function () {\n  var links = Array.prototype.slice.call(document.querySelectorAll(\'.side-nav .side-link\'));\n  if (!links.length) { return; }\n  var reduce = false, fine = false;\n  try {\n    reduce = window.matchMedia(\'(prefers-reduced-motion: reduce)\').matches;\n    fine = window.matchMedia(\'(hover: hover) and (pointer: fine)\').matches;\n  } catch (error) { /* 无法判定媒体能力时不启用 */ }\n  if (reduce || !fine) { return; }\n\n  var DOCK_GROW = 12;   // 最近处行高增量（px）：36 → 48\n  var DOCK_RANGE = 120; // 磁吸影响半径（px）：超出此距离的条目保持原尺寸\n  var DOCK_ICON_GROW = 0.35; // 图标随放大系数增加的比例（1 → 1.35）\n  var DOCK_SPRING = { mass: 0.1, stiffness: 150, damping: 12 }; // 参考组件默认弹簧参数\n\n  var sidebar = document.getElementById(\'console-side\');\n  if (!sidebar) { return; }\n  var items = links.map(function (link) {\n    var base = link.offsetHeight;\n    link.style.height = base + \'px\';\n    return { link: link, icon: link.querySelector(\'.ic\'), base: base, x: 0, v: 0, t: 0 };\n  });\n  var pointerY = null;\n  var raf = null;\n  var last = 0;\n\n  function computeTargets() {\n    for (var i = 0; i < items.length; i += 1) {\n      var item = items[i];\n      var rect = item.link.getBoundingClientRect();\n      var center = rect.top + rect.height / 2;\n      var distance = pointerY === null ? Infinity : Math.abs(pointerY - center);\n      // 与参考组件一致：半径内线性衰减，半径外为 0\n      item.t = distance >= DOCK_RANGE ? 0 : 1 - distance / DOCK_RANGE;\n    }\n  }\n\n  function frame(now) {\n    var dt = Math.min(Math.max((now - last) / 1000, 0.001), 0.1);\n    last = now;\n    var steps = Math.max(1, Math.ceil(dt / (1 / 120)));\n    var h = dt / steps;\n    var busy = false;\n    for (var i = 0; i < items.length; i += 1) {\n      var item = items[i];\n      for (var s = 0; s < steps; s += 1) {\n        var accel = (-DOCK_SPRING.stiffness * (item.x - item.t) - DOCK_SPRING.damping * item.v) / DOCK_SPRING.mass;\n        item.v += accel * h;\n        item.x += item.v * h;\n      }\n      if (Math.abs(item.x - item.t) > 0.001 || Math.abs(item.v) > 0.001) { busy = true; }\n      item.link.style.height = (item.base + DOCK_GROW * item.x) + \'px\';\n      if (item.icon) { item.icon.style.transform = \'scale(\' + (1 + DOCK_ICON_GROW * item.x) + \')\'; }\n    }\n    raf = busy ? requestAnimationFrame(frame) : null;\n  }\n\n  function kick() {\n    if (raf !== null) { return; }\n    last = performance.now();\n    raf = requestAnimationFrame(frame);\n  }\n\n  sidebar.addEventListener(\'mousemove\', function (event) {\n    pointerY = event.clientY;\n    computeTargets();\n    kick();\n  });\n  sidebar.addEventListener(\'mouseleave\', function () {\n    pointerY = null;\n    computeTargets();\n    kick();\n  });\n  var scroller = sidebar.querySelector(\'.side-nav\');\n  if (scroller) {\n    scroller.addEventListener(\'scroll\', function () {\n      if (pointerY === null) { return; }\n      computeTargets();\n      kick();\n    });\n  }\n})();\n</script>\n</body></html>'

