# /etc/b2b/b2b.env —— 私有运行配置示例（复制后改权限：chown root:b2b && chmod 0640）
# 规则：密钥只写在本文件（绝不入 Git、文档、日志、截图、聊天）；不需要的变量保持注释。
# 注意：环境变量前不要有空格；值不要加引号（systemd EnvironmentFile 语义）。

# ── 持久上传目录（部署必配；见 deploy/README.md 第 4 节）────────────────────
B2B_UPLOAD_DIR=/var/lib/b2b/data/uploads

# ── 平台模型服务（正式启用时取消注释并填入；不填=本地规则模式）─────────────
# 官方通道固定 deepseek-flash + 思考开启(强度 low)；密钥只放这里。
#AI_MODE=deepseek
#DEEPSEEK_API_KEY=

# ── 可选模型相关（一般不需要）──────────────────────────────────────────────
#DEEPSEEK_TIMEOUT_SECONDS=20
#DEEPSEEK_MAX_TOKENS=1024

# ── 渠道接入（首发仅官网/Telegram/WhatsApp；按 T5 联调进度启用）────────────
# Telegram（经 LangBot 桥）：
#LANGBOT_API_KEY=
# WhatsApp 官方（Twilio 或 Meta；二选一，与渠道页配置一致）：
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_WHATSAPP_FROM=
#META_WHATSAPP_TOKEN=
#META_PHONE_NUMBER_ID=
#META_VERIFY_TOKEN=
#META_APP_SECRET=
# WhatsApp 个人版桥（WAHA；由本机 docker 提供）：
#WHATSAPP_PERSONAL_API_KEY=
#WHATSAPP_PERSONAL_SELF_IDS=
# 企业专属桥（运营预部署，pilot-t4；应用只读私有注册表，运行工具之前不要打开）：
#WHATSAPP_PERSONAL_BRIDGES_FILE=/var/lib/b2b/data/connection-runtime/enterprise-bridges.json

# ── 共享 Dify：对外生成保持关闭，本部署不配置 DIFY_* 变量 ─────────────────

# ── 部署/备份路径覆盖（可选；b2b-app 与 b2b-backup 单元共用读取本文件）─────
# 一般不需要改；确有自定义目录时取消注释并改成实际路径。
#B2B_APP_DIR=/opt/b2b/app
#B2B_DATA_DIR=/var/lib/b2b/data
#B2B_BACKUP_ROOT=/var/backups/b2b
#B2B_BACKUP_KEEP_DAYS=14
#B2B_ENV_FILE=/etc/b2b/b2b.env
