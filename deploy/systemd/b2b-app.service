# B2B 售前平台：单机应用服务（非 root、仅本机端口）。
# 安装：sudo cp deploy/systemd/b2b-app.service /etc/systemd/system/ && sudo systemctl daemon-reload
[Unit]
Description=B2B presales platform (single-node MVP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=b2b
Group=b2b
WorkingDirectory=/opt/b2b/app
EnvironmentFile=/etc/b2b/b2b.env
# 仅监听本机回环；公网入口只经反向 HTTPS 代理（deploy/nginx-b2b.conf.example）。
# 明文库路径固定指向持久数据目录；上传目录由 B2B_UPLOAD_DIR 在 b2b.env 中配置。
ExecStart=/opt/b2b/venv/bin/python3 /opt/b2b/app/app.py --host 127.0.0.1 --port 8000 --db /var/lib/b2b/data/app.db
Restart=on-failure
RestartSec=3
UMask=0077
# 进程加固：只允许写 /var/lib/b2b；不写系统、家目录与 /tmp。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/b2b
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
